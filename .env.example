# Copia questo file in .env e inserisci i tuoi valori reali.
# .env NON deve mai essere committato in git (è già in .gitignore).

# Indirizzo Gmail mittente (deve avere una password per le app generata su
# https://myaccount.google.com/apppasswords)
CECCHINO_EMAIL_FROM=tuonome@gmail.com

# Indirizzo a cui inviare gli alert (puoi lasciarlo uguale al mittente)
CECCHINO_EMAIL_TO=tuonome@gmail.com

# Password per le app di Gmail (16 caratteri, senza spazi o con spazi, non la password normale)
CECCHINO_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
