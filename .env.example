# Copia questo file in .env e inserisci i tuoi valori reali.
# .env NON deve mai essere committato in git (è già in .gitignore).

# --- Mittente delle mail di alert (account Gmail con password per le app) ---
# Genera la password su https://myaccount.google.com/apppasswords
CECCHINO_EMAIL_FROM=tuonome@gmail.com
CECCHINO_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# --- Segreto per il tick esterno (es. GitHub Actions) ---
# Stringa lunga e casuale, es. genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
CECCHINO_CRON_SECRET=cambia-questa-stringa-casuale

# URL pubblico dove l'app è raggiungibile (usato solo nel testo delle mail)
CECCHINO_PUBLIC_URL=http://localhost:5000
