# Copia questo file in .env e inserisci i tuoi valori reali.
# .env NON deve mai essere committato in git (è già in .gitignore).

# --- Mittente delle mail di alert (account Gmail con password per le app) ---
# Genera la password su https://myaccount.google.com/apppasswords
CECCHINO_EMAIL_FROM=tuonome@gmail.com
CECCHINO_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# --- Login "Accedi con Google" ---
# Crea le credenziali su https://console.cloud.google.com/apis/credentials
# (OAuth client ID, tipo "Applicazione web"). Come Authorized redirect URI
# inserisci: <URL-PUBBLICO-APP>/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Sicurezza sessione e cron esterno ---
# Stringhe lunghe e casuali, generale es. con: python3 -c "import secrets; print(secrets.token_hex(32))"
CECCHINO_SECRET_KEY=cambia-questa-stringa-casuale
CECCHINO_CRON_SECRET=cambia-anche-questa

# URL pubblico dove l'app è raggiungibile (usato nel testo delle mail e
# per costruire il redirect URI di Google in produzione)
CECCHINO_PUBLIC_URL=http://localhost:5000
